<?xml version="1.0"?>
<ruleset name="Kabuto">
    <description>Focused style rules for the zero-dependency Kabuto codebase.</description>
    <file>core</file>
    <file>tests</file>
    <file>config</file>
    <file>app</file>
    <file>database</file>
    <file>public</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>

# Kabuto environment template.
# Copy to .env and fill in the blanks:  cp .env.example .env
# Real environment variables always win over .env values.

# Application
APP_NAME=Kabuto
APP_ENV=local                  # local | staging | production
APP_DEBUG=false                # true | false (keep false in production)
APP_TIMEZONE=UTC
APP_KEY=                       # required — generate with: php kabuto key:generate
CORS_ORIGIN=                   # optional — e.g. http://localhost:3000 or *

# Database
DB_CONNECTION=mysql            # default datasource name in database/schema.php
DB_DRIVER=mysql                # mysql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=                   # required — your database password
JWT_SECRET=                    # optional — use a separate random secret for JWTs
# SQLite alternative (set DB_DRIVER=sqlite):
# DB_PATH=database/app.sqlite

# Server Runtime
SERVER_WORKERS=auto               # auto | number of workers (auto detects CPU cores)
SERVER_WORKER_MULTIPLIER=1        # Multiplier when SERVER_WORKERS=auto (e.g. 2 for 2x cores)
SERVER_MAX_REQUESTS=100000        # Max requests before memory recycle (0 = unlimited)

# Logging
LOG_CHANNEL=app
LOG_LEVEL=info                     # debug | info | warning | error
LOG_HTTP=false                     # true to log request status and duration
LOG_PATH=storage/logs/kabuto.log
